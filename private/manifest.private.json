{
  "manifest_version": 3,
  "name": "SideNbr (Private)",
  "version": "0.3.1",
  "minimum_chrome_version": "114",
  "description": "\u3010\u79c1\u6709/\u517c\u5bb9\u6784\u5efa \u00b7 \u52ff\u4e0a\u67b6\u5546\u5e97\u3011\u5728 Chrome \u4fa7\u8fb9\u680f\u4e2d\u5207\u6362 Perplexity\u3001ChatGPT\u3001DeepSeek \u4e0e Grok\uff0c\u5e76\u53ef\u9009\u7ed5\u8fc7\u90e8\u5206 frame \u9650\u5236\u3002",
  "permissions": [
    "sidePanel",
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "browsingData"
  ],
  "host_permissions": [
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://openai.com/*",
    "https://*.openai.com/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://deepseek.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://x.ai/*",
    "https://*.x.ai/*",
    "https://challenges.cloudflare.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame_compatibility",
        "enabled": true,
        "path": "frame-bypass-rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "\u6253\u5f00\u6216\u5173\u95ed SideNbr (Private)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https: http: data: blob:;"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
