{
  "manifest_version": 3,
  "name": "SideNbr",
  "version": "0.3.1",
  "minimum_chrome_version": "114",
  "description": "\u5728 Chrome \u4fa7\u8fb9\u680f\u4e2d\u5207\u6362 Perplexity\u3001ChatGPT\u3001DeepSeek \u4e0e Grok\u3002",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://chatgpt.com/*",
    "https://openai.com/*",
    "https://*.openai.com/*",
    "https://chat.deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://deepseek.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://x.ai/*",
    "https://*.x.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "\u6253\u5f00\u6216\u5173\u95ed SideNbr"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https: http: data: blob:;"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
