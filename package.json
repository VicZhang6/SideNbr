{
  "name": "sidenbr",
  "version": "0.7.2",
  "private": true,
  "description": "Chrome side panel for Perplexity, ChatGPT, DeepSeek, Grok, and custom sites",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "check-build": "node scripts/check-build.mjs",
    "pack": "npm run build && npm run check-build && node scripts/package-dist.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "powerglitch": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
